---
import '../styles/global.css';
import { dicts, localePath, type Locale } from '../i18n';
import { compactScript } from '../lib/inline-script';
import detectPlatform from '../scripts/detect-platform.js?raw';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  // Path below the locale root, e.g. 'features/'.
  page?: string;
  noindex?: boolean;
}

const { locale, title, description, page = '', noindex = false } = Astro.props;
const t = dicts[locale];
const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;
const canonical = new URL(localePath(locale, page), Astro.site).href;
const ogImage = new URL('/icons/nagram.png', Astro.site).href;

// Same-site pages are fetched on hover or press, so the next page opens at once.
// Downloads and the API are left out: they redirect to other sites.
const speculationRules = {
  prefetch: [
    {
      where: {
        and: [
          { href_matches: '/*' },
          { not: { href_matches: '/download/*' } },
          { not: { href_matches: '/api/*' } },
        ],
      },
      eagerness: 'moderate',
    },
  ],
};
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline set:html={compactScript(detectPlatform)} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="alternate" hreflang="zh-CN" href={new URL(localePath('zh', page), Astro.site).href} />
    <link rel="alternate" hreflang="en" href={new URL(localePath('en', page), Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('zh', page), Astro.site).href} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nagram" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <script type="speculationrules" is:inline set:html={JSON.stringify(speculationRules)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.ui.skipToContent}</a>
    <slot />
  </body>
</html>
