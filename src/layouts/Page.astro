---
import Footer from '../components/layout/Footer.astro';
import GlobalNav from '../components/layout/GlobalNav.astro';
import type { Locale } from '../i18n';
import Base from './Base.astro';

interface Props {
  locale: Locale;
  // Path below the locale root, e.g. 'features/'. Empty for the home page.
  page?: string;
  title?: string;
  description?: string;
  // Breadcrumb label for pages below the home page.
  crumb?: string;
}

const { locale, page = '', title, description, crumb } = Astro.props;
---

<Base locale={locale} page={page} title={title} description={description}>
  <GlobalNav locale={locale} page={page} />
  <main id="main">
    <slot />
  </main>
  <Footer locale={locale} page={page} crumb={crumb} />
</Base>
