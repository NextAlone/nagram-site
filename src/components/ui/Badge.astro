---
import type { HTMLAttributes } from 'astro/types';
import type { IconName } from '../../icons';
import Icon from './Icon.astro';

export type BadgeTone = 'accent' | 'neutral' | 'positive' | 'warning' | 'brand';

interface Props extends HTMLAttributes<'span'> {
  tone?: BadgeTone;
  icon?: IconName;
  size?: 's' | 'm';
}

const { tone = 'neutral', icon, size = 's', class: className, ...rest } = Astro.props;
---

<span class:list={['badge', `badge--${tone}`, `badge--${size}`, className]} {...rest}>
  {icon && <Icon name={icon} stroke={2} />}
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    border-radius: var(--r-pill);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: var(--tr-caption);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .badge--s {
    padding: 3px 8px;
    font-size: var(--t-caption);
  }

  .badge--m {
    padding: 5px 11px;
    font-size: var(--t-footnote);
  }

  .badge--neutral {
    background: var(--c-fill);
    color: var(--c-text-2);
  }

  .badge--accent {
    background: var(--c-accent-tint);
    color: var(--c-link);
  }

  .badge--positive {
    background: color-mix(in srgb, var(--c-positive) 14%, transparent);
    color: var(--c-positive);
  }

  .badge--warning {
    background: color-mix(in srgb, var(--c-warning) 14%, transparent);
    color: var(--c-warning);
  }

  .badge--brand {
    background: linear-gradient(100deg, var(--brand-1), var(--brand-2) 55%, var(--brand-3));
    color: #fff;
  }
</style>
