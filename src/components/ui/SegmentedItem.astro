---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  selected?: boolean;
}

const { selected = false, class: className, ...rest } = Astro.props;
---

<li>
  <a class:list={['segment', className]} aria-current={selected ? 'true' : undefined} {...rest}>
    {Astro.slots.has('icon') && <span class="segment__icon"><slot name="icon" /></span>}
    <span class="segment__label"><slot /></span>
  </a>
</li>

<style>
  li {
    flex: none;
  }

  .segment {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 36px;
    padding: 0 var(--s-4) 0 var(--s-3);
    border-radius: var(--r-pill);
    color: var(--c-text);
    font-size: var(--t-subhead);
    font-weight: 500;
    letter-spacing: var(--tr-small);
    white-space: nowrap;
    text-decoration: none;
    transition:
      background-color var(--d-fast) var(--ease),
      box-shadow var(--d-fast) var(--ease);
    -webkit-tap-highlight-color: transparent;
  }

  .segment:not(:has(.segment__icon)) {
    padding-inline: var(--s-4);
  }

  .segment:hover {
    text-decoration: none;
    background: var(--c-fill);
  }

  .segment[aria-current] {
    background: var(--c-selected);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.08),
      0 3px 10px rgb(0 0 0 / 0.06);
  }

  .segment__icon {
    display: inline-flex;
    flex: none;
  }
</style>
