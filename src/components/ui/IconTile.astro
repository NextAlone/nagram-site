---
import type { HTMLAttributes } from 'astro/types';
import type { Tone } from '../../design/tones';
import type { IconName } from '../../icons';
import Icon from './Icon.astro';

interface Props extends HTMLAttributes<'span'> {
  icon: IconName;
  tone?: Tone;
  size?: 'xs' | 's' | 'm' | 'l' | 'xl';
  // solid: white glyph on a colored tile, as in iOS Settings; tinted: colored
  // glyph on a pale tile; neutral: gray tile, text-colored glyph.
  variant?: 'solid' | 'tinted' | 'neutral';
}

const { icon, tone = 'blue', size = 'm', variant = 'solid', class: className, ...rest } = Astro.props;
---

<span
  class:list={['tile', `tile--${size}`, `tile--${variant}`, className]}
  style={`--tone: var(--tone-${tone})`}
  aria-hidden="true"
  {...rest}
>
  <Icon name={icon} stroke={variant === 'solid' ? 2 : 1.75} />
</span>

<style>
  .tile {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: var(--tile-size);
    height: var(--tile-size);
    border-radius: 23%;
    font-size: var(--glyph-size);
  }

  @supports (corner-shape: squircle) {
    .tile {
      border-radius: 50%;
      corner-shape: squircle;
    }
  }

  .tile--xs {
    --tile-size: 24px;
    --glyph-size: 15px;
  }

  .tile--s {
    --tile-size: 30px;
    --glyph-size: 18px;
  }

  .tile--m {
    --tile-size: 44px;
    --glyph-size: 24px;
  }

  .tile--l {
    --tile-size: 56px;
    --glyph-size: 30px;
  }

  .tile--xl {
    --tile-size: 76px;
    --glyph-size: 40px;
  }

  .tile--solid {
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.22), rgb(255 255 255 / 0) 60%),
      var(--tone);
    color: #fff;
    box-shadow: inset 0 0 0 0.5px rgb(0 0 0 / 0.08);
  }

  .tile--tinted {
    background: color-mix(in srgb, var(--tone) 14%, transparent);
    color: var(--tone);
  }

  .tile--neutral {
    background: var(--c-fill);
    color: var(--c-text);
  }
</style>
