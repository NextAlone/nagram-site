---
import Page from '../layouts/Page.astro';
import { FEATURE_GROUPS, FEATURE_COLUMNS } from '../data/features';
import { dicts, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dicts[locale];
const f = t.featureList;
---

<Page locale={locale} page="features/" title={`${f.title} · Nagram`} description={f.description}>
  <main class="subpage">
    <h1>{f.title}</h1>
    <p class="lead">{f.lead}</p>

    <section class="feature-group">
      <h2>{t.features.title}</h2>
      <p class="section-lead">{t.features.lead}</p>
      <ul class="feature-grid">
        {
          t.features.items.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {
      FEATURE_GROUPS.map((group, i) => (
        <details class="feature-group" open={i === 0}>
          <summary>
            <h2>{group[locale]}</h2>
            <span class="count">{group.rows.length}</span>
          </summary>
          <table class="feature-table">
            <thead>
              <tr>
                <th scope="col">{f.feature}</th>
                {FEATURE_COLUMNS.map((c) => (
                  <th scope="col" title={c.name}>
                    {c.short}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {group.rows.map((row) => (
                <tr>
                  <th scope="row">
                    {row[locale]}
                    {row.note && <small>{row.note[locale]}</small>}
                  </th>
                  {FEATURE_COLUMNS.map((c) =>
                    row.on.includes(c.id) ? (
                      <td class="yes" aria-label={f.supported}>
                        ✓
                      </td>
                    ) : (
                      <td class="no" aria-label={f.unsupported}>
                        –
                      </td>
                    ),
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </details>
      ))
    }

    <p class="feature-footnote">{f.footnote}</p>
  </main>
</Page>
