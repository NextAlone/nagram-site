---
import { existsSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import { PRODUCTS, releasesPageUrl, repoUrl } from '../data/products';
import { dicts, localePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dicts[locale];
const other: Locale = locale === 'zh' ? 'en' : 'zh';

const heroPlatforms = [
  { platform: 'android', label: 'Android', product: 'nagram-android' },
  { platform: 'ios', label: 'iOS', product: 'nagram-ios' },
  { platform: 'windows', label: 'Windows', product: 'nagram-desktop' },
  { platform: 'macos', label: 'macOS', product: 'nagram-desktop' },
  { platform: 'linux', label: 'Linux', product: 'nagram-desktop' },
];

const productById = Object.fromEntries(PRODUCTS.map((p) => [p.id, p]));

// A slot renders a single image when public/screenshots has one without a theme
// suffix, a light/dark pair when both variants exist, and a placeholder otherwise.
const shots = PRODUCTS.map((p) => ({
  product: p,
  portrait: p.id !== 'nagram-desktop',
  slots: t.screenshots.slots[p.id].map((caption, i) => {
    const base = `/screenshots/${p.id}-${i + 1}`;
    const single = existsSync(`public${base}.webp`);
    const themed = ['light', 'dark'].every((theme) => existsSync(`public${base}-${theme}.webp`));
    return { caption, base, single, themed };
  }),
}));

const links = {
  channel: 'https://t.me/nagram_channel',
  group: 'https://t.me/nagram_group',
  nnngramChannel: 'https://t.me/Nnngram',
};
---

<Base locale={locale}>
  <header class="site-header">
    <a class="brand" href={localePath(locale)}>
      <img src="/icons/nagram.png" alt="" width="28" height="28" />
      <span>Nagram</span>
    </a>
    <nav>
      <a href="#products">{t.nav.products}</a>
      <a href="#features">{t.nav.features}</a>
      <a href="#screenshots">{t.nav.screenshots}</a>
      <a class="lang" href={localePath(other)} lang={dicts[other].htmlLang} hreflang={dicts[other].htmlLang}>
        {t.nav.switchLabel}
      </a>
    </nav>
  </header>

  <main
    id="releases-root"
    data-loading={t.release.loading}
    data-unavailable={t.release.unavailable}
    data-no-release={t.release.noRelease}
    data-external={t.release.external}
  >
    <section class="hero">
      <img class="hero-icon" src="/icons/nagram.png" alt="Nagram" width="112" height="112" />
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1>{t.hero.title.map((line) => <span>{line}</span>)}</h1>
      <p class="lead">{t.hero.lead}</p>
      <div class="hero-downloads" aria-label={t.hero.downloadsLabel}>
        {
          heroPlatforms.map((h) => (
            <a
              class="btn"
              href={`/download/${h.platform}`}
              data-dl={h.platform}
              data-product={h.product}
              data-fallback={releasesPageUrl(productById[h.product])}
            >
              {h.label}
            </a>
          ))
        }
      </div>
      <p class="hero-note" id="detected-note" hidden>{t.hero.detected}</p>
    </section>

    <section id="products" class="section">
      <h2>{t.products.title}</h2>
      <p class="section-lead">{t.products.lead}</p>
      <div class="cards">
        {
          PRODUCTS.map((p) => {
            const item = t.products.items[p.id];
            const fallback = releasesPageUrl(p);
            // Stable and beta are told apart only where a product offers both.
            const prefix = p.links?.some((l) => l.kind === 'beta') ? t.release.stable : t.release.download;
            return (
              <article class="card" id={p.id}>
                <header>
                  <img src={p.icon} alt="" width="56" height="56" loading="lazy" />
                  <div>
                    <h3>{p.name}</h3>
                    <p class="platform">{item.platform}</p>
                  </div>
                </header>
                <p class="tagline">{item.tagline}</p>
                <p class="version">
                  <span class="version-label">{t.products.version}</span>
                  <span class="version-value" data-version={p.id} />
                  <noscript>{t.release.unavailable}</noscript>
                </p>
                <ul class="feature-list">
                  {item.features.map((f) => <li>{f}</li>)}
                </ul>
                <div class="card-actions">
                  {
                    p.downloads.map((d) => (
                      <a
                        class="btn btn-small"
                        href={`/download/${d.platform}`}
                        data-dl={d.platform}
                        data-product={p.id}
                        data-fallback={fallback}
                      >
                        {prefix} · {d.label}
                      </a>
                    ))
                  }
                  {p.links?.map((l) => (
                    <a class="btn btn-small" href={l.url}>
                      {t.release.links[l.kind]}
                    </a>
                  ))}
                  {p.source.type === 'github' && (
                    <a class="text-link" href={fallback}>
                      {t.release.releasesPage}
                    </a>
                  )}
                  <a class="text-link" href={repoUrl(p.repo)}>{t.products.source}</a>
                </div>
              </article>
            );
          })
        }
      </div>
    </section>

    <section id="features" class="section">
      <h2>{t.features.title}</h2>
      <p class="section-lead">{t.features.lead}</p>
      <ul class="feature-grid">
        {
          t.features.items.map((f) => (
            <li>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="screenshots" class="section">
      <h2>{t.screenshots.title}</h2>
      <p class="section-lead">{t.screenshots.lead}</p>
      {
        shots.map((group) => (
          <div class="shot-group">
            <h3>{group.product.name}</h3>
            <div class:list={['shots', { portrait: group.portrait }]}>
              {group.slots.map((s) => (
                <figure>
                  {s.single ? (
                    <img src={`${s.base}.webp`} alt={`${group.product.name}: ${s.caption}`} loading="lazy" />
                  ) : s.themed ? (
                    <picture>
                      <source srcset={`${s.base}-dark.webp`} media="(prefers-color-scheme: dark)" />
                      <img src={`${s.base}-light.webp`} alt={`${group.product.name}: ${s.caption}`} loading="lazy" />
                    </picture>
                  ) : (
                    <div class="shot-placeholder">{t.screenshots.pending}</div>
                  )}
                  <figcaption>{s.caption}</figcaption>
                </figure>
              ))}
            </div>
          </div>
        ))
      }
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-cols">
      <div>
        <h2>{t.footer.community}</h2>
        <ul>
          <li><a href={links.channel}>{t.footer.channel}</a></li>
          <li><a href={links.group}>{t.footer.group}</a></li>
          <li><a href={links.nnngramChannel}>{t.footer.nnngramChannel}</a></li>
        </ul>
      </div>
      <div>
        <h2>{t.footer.code}</h2>
        <ul>
          {PRODUCTS.map((p) => <li><a href={repoUrl(p.repo)}>{p.repo}</a></li>)}
        </ul>
      </div>
      <div class="footer-wide">
        <h2>{t.footer.license}</h2>
        <p>{t.footer.licenseBody}</p>
      </div>
    </div>
    <p class="disclaimer">{t.footer.disclaimer}</p>
  </footer>
</Base>

<script>
  import '../scripts/home';
</script>
