---
import { DOWNLOAD_ANCHOR } from '../../../config/site';
import { PRODUCTS, type ReleasesResponse } from '../../../data/products';
import { dicts, type Locale } from '../../../i18n';
import Headline from '../../ui/Headline.astro';
import Section from '../../ui/Section.astro';
import LineupCard from './LineupCard.astro';

interface Props {
  locale: Locale;
  releases: ReleasesResponse;
}

const { locale, releases } = Astro.props;
const t = dicts[locale];
---

<Section tone="base" id={DOWNLOAD_ANCHOR} class="lineup-section" aria-labelledby="lineup-title">
  <Headline title={t.products.title} titleId="lineup-title" lead={t.products.lead} />
  <div slot="bleed" class="lineup" data-reveal>
    {PRODUCTS.map((p) => <LineupCard product={p} info={releases.products[p.id]} locale={locale} />)}
  </div>
</Section>

<style>
  .lineup-section {
    scroll-margin-top: var(--nav-h);
  }

  /* Swipes on narrow screens; four columns once they fit. */
  .lineup {
    --inset: max(var(--gutter), (100% - var(--w-wide)) / 2);
    display: grid;
    grid-template-rows: repeat(7, auto);
    grid-auto-flow: column;
    grid-auto-columns: min(82vw, 340px);
    gap: 0 var(--s-4);
    padding: var(--s-2) var(--inset) var(--s-4);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-padding-inline: var(--inset);
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .lineup::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 1068px) {
    .lineup {
      grid-auto-columns: minmax(0, 1fr);
      gap: 0 var(--s-5);
      overflow: visible;
    }
  }
</style>
