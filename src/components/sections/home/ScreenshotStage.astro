---
import { PRODUCTS } from '../../../data/products';
import { dicts, localePath, type Locale } from '../../../i18n';
import { isPortrait, screenshotsFor } from '../../../lib/screenshots';
import Headline from '../../ui/Headline.astro';
import Marquee from '../../ui/Marquee.astro';
import Stage from '../../ui/Stage.astro';
import TextLink from '../../ui/TextLink.astro';
import ShotImage from '../shared/ShotImage.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dicts[locale];
// The stage shows the first client that has real screenshots.
const featured = PRODUCTS.map((p) => ({ product: p, shots: screenshotsFor(p.id, t.screenshots.slots[p.id]) })).find(
  (entry) => entry.shots.some((s) => s.kind !== 'pending'),
);
const shown = featured?.shots.filter((s) => s.kind !== 'pending') ?? [];
---

{
  featured && (
    <Stage light="low" aria-labelledby="teaser-title">
      <Headline title={t.screenshots.title} titleId="teaser-title" eyebrow={featured.product.name} metal>
        <TextLink href={localePath(locale, 'screenshots/')}>{t.ui.seeAllScreenshots}</TextLink>
      </Headline>
      <Marquee
        slot="bleed"
        label={`${featured.product.name} · ${t.screenshots.title}`}
        count={shown.length}
        perItem={7}
        gap="clamp(16px, 2.4vw, 28px)"
        labels={{ pause: t.ui.pause, play: t.ui.play }}
      >
        {
          shown.map((shot) => (
            <li class="teaser__item">
              <figure>
                <ShotImage
                  shot={shot}
                  alt={`${featured.product.name}: ${shot.caption}`}
                  portrait={isPortrait(featured.product.id)}
                  pendingLabel={t.screenshots.pending}
                  sizes="(min-width: 524px) 272px, 52vw"
                />
                <figcaption>{shot.caption}</figcaption>
              </figure>
            </li>
          ))
        }
      </Marquee>
    </Stage>
  )
}

<style>
  .teaser__item {
    width: clamp(196px, 52vw, 272px);
  }

  figure {
    width: 100%;
  }

  figcaption {
    margin-top: var(--s-4);
    color: var(--c-text-2);
    font-size: var(--t-subhead);
    font-weight: 500;
    text-align: center;
  }
</style>
