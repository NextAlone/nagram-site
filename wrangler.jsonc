{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // A Cloudflare Pages project without Functions: dist/ is entirely static,
  // including _headers and the _redirects the build writes for /download/*.
  "name": "nagram-site",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-01"
}
