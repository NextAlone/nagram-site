{
  "name": "nagram-site",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "types": "wrangler types",
    "check": "wrangler types && tsc --noEmit && tsc -p worker",
    "deploy": "astro build && wrangler deploy",
    "deploy:redirect": "wrangler deploy --config redirect/wrangler.jsonc"
  },
  "devDependencies": {
    "astro": "^7.3.5",
    "typescript": "^5.9.0",
    "wrangler": "^4.145.0"
  },
  "packageManager": "pnpm@12.3.4"
}
